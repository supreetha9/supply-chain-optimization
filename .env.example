# Copy to .env and tweak as needed before running `make airflow-up`.
# These values are consumed by docker-compose.yml.

# Match host UID so airflow container files are owned by you (not root).
# `id -u` on macOS / Linux returns the right value.
AIRFLOW_UID=50000

# Initial admin user created by airflow-init on first start.
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FIRSTNAME=Supply
AIRFLOW_LASTNAME=Admin
AIRFLOW_EMAIL=supply@example.com

# MLflow tracking URI.
#   - Inside the docker-compose network (Airflow tasks): http://mlflow:5000
#   - On the host (running `make forecast` from your shell): http://localhost:5000
# forecast.py fails fast if this is unset (no silent file-store fallback).
MLFLOW_TRACKING_URI=http://localhost:5000
